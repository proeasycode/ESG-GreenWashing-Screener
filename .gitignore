# ==============================================================================
# GreenWash-Screener .gitignore
# ==============================================================================

# Secrets and Environment Variables
.env
*.env.local

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.gemini/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
tmp/
temp/
