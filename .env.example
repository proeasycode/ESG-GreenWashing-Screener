# ==============================================================================
# GreenWash-Screener: Example Environment Template
# Copy this file to '.env' and fill in your API keys if desired.
# Note: The app functions 100% offline even with no API keys provided.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Google Gemini (Free API Key available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Optional: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NVIDIA NIM (Optional: https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
